# Render supplies PORT in production; 5000 is for local development.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string in production.
MONGO_URI=your_mongodb_connection_string

# Exact frontend origin, for example https://your-site.netlify.app.
CLIENT_URL=http://localhost:5173

# Use a long random value and set it only in the host environment.
JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=7d

RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_CURRENCY=INR

JITSI_BASE_URL=https://meet.jit.si

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret
RECORDING_MAX_BYTES=52428800
